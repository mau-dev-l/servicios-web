PORT=3000
# Usa "db" cuando el backend corre en docker compose.
# Usa "localhost" si corres el backend fuera de docker (node server.js).
DB_HOST=db
DB_USER=api_user
DB_PASSWORD=yourpassword
DB_NAME=demo_db
DB_PORT=3306
JWT_SECRET=clave_secreta
# Solo para el contenedor MySQL (no lo usa el backend).
MYSQL_ROOT_PASSWORD=yourrootpassword

# Ollama / RAG
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
EMBEDDING_MODEL=nomic-embed-text
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.60

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# URL HTTPS publica del tunel, por ejemplo https://algo.trycloudflare.com
PUBLIC_BASE_URL=
