PORT=3000
# Usa "db" cuando el backend corre en docker compose.
# Usa "localhost" si corres el backend fuera de docker (node server.js).
DB_HOST=db
DB_USER=api_user
DB_PASSWORD=yourpassword
DB_NAME=demo_db
DB_PORT=3306
JWT_SECRET=clave_secreta
# Solo para el contenedor MySQL (no lo usa el backend).
MYSQL_ROOT_PASSWORD=yourrootpassword
